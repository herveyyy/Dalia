{
  "name": "Dalia",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "node node_modules/turbo/bin/turbo run check-types",
    "db:pull": "bun run --cwd packages/db pull",
    "db:push": "bun run --cwd packages/db push",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:reset": "bun run --cwd packages/db src/reset.ts",
    "db:studio": "bun run --cwd packages/db studio",
    "create-zone": "bun scripts/create-zone.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.11"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}