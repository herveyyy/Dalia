# Root Environment Variables for Dalia Monorepo

# Neon Postgres (same as packages/db)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth — secret must be at least 32 chars
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Multi-Zone App URLs (see zones.config.mjs)
DOCS_URL=http://localhost:3001
HRIS_URL=http://localhost:3002
USER_URL=http://localhost:3003

